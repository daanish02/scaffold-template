---
import ConceptLayout from "../layouts/ConceptLayout.astro";
import ConceptLink from "@daanish02/scaffold-core/components/content/ConceptLink.astro";

// Placeholder homepage — replace with your KB's real landing page once
// sample content is swapped for real sections/concepts.
const base = import.meta.env.BASE_URL;
---

<ConceptLayout title="Home" kb="math">
  <h1>Scaffold · [Subject]</h1>
  <p>This is the template's placeholder homepage. Replace it with your KB's real landing page.</p>
  <p>
    <a href={`${base}sample-section/sample-concept/`}>View the sample concept page</a>
  </p>
</ConceptLayout>
